MESSAGE_IO_API_KEY=change-this-api-key
MESSAGE_IO_DB=./data/message_io.sqlite3
MESSAGE_IO_HOST=0.0.0.0
MESSAGE_IO_PORT=8000
MESSAGE_IO_LOG_LEVEL=info

# 飞书开放平台应用凭证。使用应用机器人后，不需要为每个群配置 webhook。
FEISHU_ENABLED=true
FEISHU_APP_ID=cli_xxxx
FEISHU_APP_SECRET=xxxx
FEISHU_ACCOUNT_ID=default
FEISHU_LISTENER_ENABLED=true

# 事件订阅里的 Verification Token。留空时禁用 POST /feishu/events HTTP 回调。
FEISHU_EVENT_VERIFY_TOKEN=

# 如果事件订阅启用了 Encrypt Key，就填写；未启用可留空。
FEISHU_EVENT_ENCRYPT_KEY=

# 消息被成功确认后，给飞书原消息加一个 reaction。
FEISHU_MARK_DELIVERED_REACTION=true
FEISHU_DELIVERED_REACTION_EMOJI=Get

# 飞书 HTTP API 临时失败时的有限重试。
FEISHU_RETRY_ATTEMPTS=3
FEISHU_RETRY_BASE_DELAY=0.5

# 长连接监听异常退出后的自动重连退避。
FEISHU_LISTENER_RETRY_BASE_DELAY=1
FEISHU_LISTENER_RETRY_MAX_DELAY=60

# ack=false 可靠读取模式的消息租约时长。
MESSAGE_IO_LEASE_SECONDS=300

# 启动和维护清理时保留历史数据的天数。
MESSAGE_IO_DELIVERED_RETENTION_DAYS=30
MESSAGE_IO_PROCESSED_RETENTION_DAYS=30
